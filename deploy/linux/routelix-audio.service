[Unit]
Description=Routelix PulseAudio or PipeWire daemon
After=sound.target
Before=routelix.service

[Service]
Type=simple
User=routelix
Group=routelix
RuntimeDirectory=routelix
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/routelix
ExecStart=@APP_DIR@/deploy/linux/audio-daemon.sh
Restart=always
RestartSec=3
MemoryMax=1G

[Install]
WantedBy=multi-user.target
